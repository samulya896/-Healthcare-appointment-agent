# Gemini API key (server-side only, never expose to the client).
# Get one at https://aistudio.google.com/app/apikey. Leave empty to use the built-in clinical fallback.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
PORT=3001
# Comma-separated list of browser origins allowed to call this API (your Vercel URL).
# Leave empty to allow all origins (local development).
CORS_ORIGINS=
